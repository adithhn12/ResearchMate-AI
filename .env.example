# ==============================================================================
# ResearchMate AI - Environment Configuration Template
# Copy this file to .env and populate secrets. NEVER commit .env to GitHub.
# ==============================================================================

# Google Gemini API (used for LLM + external gemini-embedding-001 embeddings)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
EMBEDDING_MODEL_NAME=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
EMBEDDING_BATCH_SIZE=16

# Supabase PostgreSQL + pgvector (Transaction/Session Pooler URI)
# Example: postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Supabase Storage (for uploaded PDFs; Render filesystem is temporary only)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_STORAGE_BUCKET=research-papers

# Backend Security & CORS
SECRET_KEY=change-this-to-a-long-random-secret
CORS_ORIGINS=*

# Bounded Ingestion Limits (Render Free 512 MB RAM protection)
MAX_UPLOAD_FILE_MB=25
MAX_PDF_PAGES=150
MAX_FILES_PER_UPLOAD=5
