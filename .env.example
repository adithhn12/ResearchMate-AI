# ========================================================
# ResearchMate AI Environment Configuration
# ========================================================

# Google Gemini API Key
# Obtain from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Name (Configurable)
# Verified working models: gemini-flash-lite-latest, gemini-3.8-flash, gemini-flash-latest
GEMINI_MODEL=gemini-flash-lite-latest

# Security & Authentication
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration (SQLite default)
DATABASE_URL=sqlite:///researchmate.db

# Vector Database (ChromaDB persistence path)
CHROMA_PERSIST_DIR=./chroma_data

# Uploaded Research Papers Storage
UPLOAD_DIR=./uploaded_papers

# Embedding Model Name (all-MiniLM-L6-v2)
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
